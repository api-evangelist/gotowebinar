    "_postman_id": "72fb6384-920a-4502-b528-d661eceb2fb2",
    "name": "GoToWebinar Webhooks Management User Subscriptions API",
    "description": "Webhook lifecycle and subscription management for GoToWebinar.\nWebhooks deliver registrant.added, registrant.joined, webinar.created, and\nwebinar.changed events to a developer-supplied callback URL, signed via the\nX-Webhook-Signature header.\n\nBoth `webhookState` and `userSubscriptionState` must be ACTIVE to enable\nwebhook events to be captured and sent.\n\nContact Support:\n Name: GoTo Developer Support\n Email: developer-support@goto.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-21T21:18:32.000Z",
    "updatedAt": "2026-10-21T21:18:33.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-72fb6384-920a-4502-b528-d661eceb2fb2"
  },
